.page-listing {
  width: 100%;
  padding: 5%;
}

.search-bar {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  padding: 30rpx;
  gap: 20rpx;
  margin-bottom: 20rpx;
  background-color: white;
}

.search-input {
  flex-basis: 80%;
  background-color: #f7f7f7;
  height: 45rpx;
}

.button-list-view {
  flex-basis: 20%;
  padding: 5rpx;
  display: flex;
  align-items: center;   
  justify-content: center;
  width: 50rpx;
  height: 50rpx;         
  background-color: #f7f7f7;
}

.button-list-view .button-image {
  max-height: 80%;
  max-width: 80%;
  object-fit: contain;
}

.layout-list-view {
  display: flex;
  flex-direction: column;
  gap: 100rpx;
}

.layout-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10rpx;
}

.layout-not-found {
  width: 100%;
  background-color: white;
  display: flex;
  align-items: center;   
  justify-content: center;
}

.card {
  padding: 20rpx;
  background-color: white;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.card-list {
  height: 500rpx;
}

.card-img-grid {
  width: 100%;
  height: 200rpx;
  object-fit: cover;
}

.card-img-list {
  width: 100%;
  height: 500rpx;
  object-fit: contain;
}

.card-body {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.card-title {
  font-weight: bold;
}